{
  "manifest_version": 3,
  "name": "Easy speech",
  "version": "1.0.0",
  "description": "Voice typing for Persian and English, with optional Gemini transcription of a recording or audio file. Inserts text at your cursor.",

  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "commands": {
    "toggle-dictation": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Start or stop voice dictation in the current tab"
    },
    "cycle-language": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Switch between your bookmarked dictation languages"
    }
  },
  "action": {
    "default_title": "Easy speech",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
