# Dependencies
node_modules/

# Build output (regenerated with `npm run build`)
dist/

# Store upload artifact (regenerated with `npm run pack`)
/*.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Environment / secrets
.env
.env.*

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Agent tooling (local session plans, installed skill packs) — not project source
.claude/
.zcode/

# Agent packaging config (tool-local)
.zcodeignore
